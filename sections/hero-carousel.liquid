<hero-carousel
  class="hero-carousel full-width"
  role="region"
  aria-roledescription="carousel"
  aria-label="{{ section.settings.heading | default: shop.name | escape }}"
>
  <div class="hero-carousel__track">
    {% for block in section.blocks %}
      <div
        class="hero-carousel__slide"
        role="group"
        aria-roledescription="slide"
        aria-label="{{ 'sections.hero_carousel.slide_position' | t: index: forloop.index, total: forloop.length }}"
        {{ block.shopify_attributes }}
      >
        {% if block.settings.image %}
          {% liquid
            assign loading = 'lazy'
            assign fetchpriority = 'auto'
            if forloop.first
              assign loading = 'eager'
              assign fetchpriority = 'high'
            endif
          %}
          {{
            block.settings.image
            | image_url: width: 2400
            | image_tag: widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', loading: loading, fetchpriority: fetchpriority
          }}
        {% else %}
          {% capture placeholder %}{% cycle 'hero-apparel-1', 'hero-apparel-2', 'hero-apparel-3' %}{% endcapture %}
          {{ placeholder | placeholder_svg_tag }}
        {% endif %}
      </div>
    {% endfor %}
  </div>

  <div class="hero-carousel__content">
    {% if section.settings.heading != blank %}
      <h2 class="hero-carousel__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    {% if section.settings.button_label != blank %}
      {% render 'button',
        label: section.settings.button_label,
        url: section.settings.button_link,
        class: 'button--inverse'
      %}
    {% endif %}
  </div>

  {% if section.blocks.size > 1 %}
    <button
      class="hero-carousel__arrow hero-carousel__arrow--previous"
      type="button"
      data-direction="-1"
      aria-label="{{ 'sections.hero_carousel.previous' | t }}"
    >
      <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M12.5 4.5 7 10l5.5 5.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <button
      class="hero-carousel__arrow hero-carousel__arrow--next"
      type="button"
      data-direction="1"
      aria-label="{{ 'sections.hero_carousel.next' | t }}"
    >
      <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M7.5 4.5 13 10l-5.5 5.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <div class="hero-carousel__dots">
      {% for block in section.blocks %}
        <button
          class="hero-carousel__dot"
          type="button"
          data-index="{{ forloop.index0 }}"
          aria-label="{{ 'sections.hero_carousel.go_to_slide' | t: index: forloop.index }}"
          {% if forloop.first %}
            aria-current="true"
          {% endif %}
        ></button>
      {% endfor %}
    </div>
  {% endif %}
</hero-carousel>

{% stylesheet %}
  .hero-carousel {
    display: block;
    position: relative;
    height: clamp(22rem, 70svh, 44rem);
    overflow: hidden;
  }

  .hero-carousel__track {
    display: flex;
    height: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }

  .hero-carousel__slide {
    position: relative;
    flex: 0 0 100%;
    height: 100%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .hero-carousel__slide::after {
    content: '';
    position: absolute;
    inset: 0;
    background-color: rgb(0 0 0 / 0.35);
  }

  .hero-carousel__slide > img,
  .hero-carousel__slide > svg {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .hero-carousel__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    padding: 3rem max(var(--page-margin), 4rem);
    color: #fff;
    text-align: center;
    pointer-events: none;
  }

  .hero-carousel__content > * {
    pointer-events: auto;
  }

  .hero-carousel__heading {
    max-width: 20ch;
    font-size: clamp(2rem, 6vw, 4rem);
    font-weight: 700;
    line-height: 1.1;
  }

  .hero-carousel__arrow {
    position: absolute;
    top: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background-color: var(--color-background);
    color: var(--color-foreground);
    cursor: pointer;
    transform: translateY(-50%);
  }

  .hero-carousel__arrow svg {
    width: 1.25rem;
  }

  .hero-carousel__arrow--previous {
    left: var(--page-margin);
  }

  .hero-carousel__arrow--next {
    right: var(--page-margin);
  }

  .hero-carousel__dots {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    display: flex;
    transform: translateX(-50%);
  }

  .hero-carousel__dot {
    width: 1.5rem;
    height: 1.5rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .hero-carousel__dot::before {
    content: '';
    display: block;
    width: 0.625rem;
    height: 0.625rem;
    margin: auto;
    border: 1px solid #fff;
    border-radius: 50%;
  }

  .hero-carousel__dot[aria-current]::before {
    background-color: #fff;
  }

  .hero-carousel__arrow:focus-visible,
  .hero-carousel__dot:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  @media (max-width: 749px) {
    .hero-carousel__arrow {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-carousel__track {
      scroll-behavior: auto;
    }
  }
{% endstylesheet %}

{% javascript %}
  class HeroCarousel extends HTMLElement {
    connectedCallback() {
      this.track = this.querySelector('.hero-carousel__track');
      this.slides = Array.from(this.querySelectorAll('.hero-carousel__slide'));
      this.dots = Array.from(this.querySelectorAll('.hero-carousel__dot'));
      this.current = 0;

      this.addEventListener('click', this.onClick);
      this.addEventListener('shopify:block:select', this.onBlockSelect);

      this.observer = new IntersectionObserver(this.onIntersect.bind(this), {
        root: this.track,
        threshold: 0.6,
      });
      this.slides.forEach((slide) => this.observer.observe(slide));
    }

    disconnectedCallback() {
      this.observer.disconnect();
    }

    onClick(event) {
      const arrow = event.target.closest('.hero-carousel__arrow');
      const dot = event.target.closest('.hero-carousel__dot');

      if (arrow) {
        this.goTo(this.current + Number(arrow.dataset.direction));
      } else if (dot) {
        this.goTo(Number(dot.dataset.index));
      }
    }

    onBlockSelect(event) {
      const index = this.slides.indexOf(event.target);
      if (index >= 0) this.goTo(index);
    }

    onIntersect(entries) {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;

        this.current = this.slides.indexOf(entry.target);
        this.dots.forEach((dot, index) => {
          if (index === this.current) {
            dot.setAttribute('aria-current', 'true');
          } else {
            dot.removeAttribute('aria-current');
          }
        });
      });
    }

    goTo(index) {
      const count = this.slides.length;
      const target = (index + count) % count;
      this.track.scrollTo({ left: this.track.clientWidth * target });
    }
  }

  if (!customElements.get('hero-carousel')) {
    customElements.define('hero-carousel', HeroCarousel);
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:general.hero_carousel",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Gear up for the ride"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "t:general.slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.hero_carousel",
      "blocks": [{ "type": "slide" }, { "type": "slide" }, { "type": "slide" }]
    }
  ]
}
{% endschema %}
