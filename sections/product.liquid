{% comment %}
  This section is used in the product template to render product page with
  media, content, and add-to-cart form.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

<div class="product-images">
  {% for image in product.images %}
    {% render 'image', class: 'product-image', image: image %}
  {% endfor %}
</div>

<div class="product-info">
  <h1>{{ product.title }}</h1>
  <p>{{ product.price | money }}</p>

  {% if product.description != blank %}
    <details class="product-description" open>
      <summary class="product-description__summary">
        <h2 class="product-description__title">{{ 'products.description' | t }}</h2>
        <svg
          class="product-description__icon"
          aria-hidden="true"
          focusable="false"
          viewBox="0 0 16 16"
          width="16"
          height="16"
        >
          <path d="M3 6l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </summary>
      <div class="product-description__content rte">
        {{ product.description }}
      </div>
    </details>
  {% endif %}
</div>

{% stylesheet %}
  .product-description {
    --product-description-border: color-mix(in srgb, var(--color-foreground) 15%, transparent);
    --product-description-muted: color-mix(in srgb, var(--color-foreground) 75%, transparent);

    margin-block-start: 2rem;
    border-block: 1px solid var(--product-description-border);
  }

  .product-description__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.25rem;
    cursor: pointer;
    list-style: none;
  }

  .product-description__summary::-webkit-details-marker {
    display: none;
  }

  .product-description__summary:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: 4px;
  }

  .product-description__title {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .product-description__icon {
    flex-shrink: 0;
    transition: transform 0.25s ease;
  }

  .product-description[open] .product-description__icon {
    transform: rotate(180deg);
  }

  .product-description__content {
    max-width: 65ch;
    padding-block-end: 1.5rem;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--product-description-muted);
  }

  .product-description__content > * + * {
    margin-block-start: 1em;
  }

  .product-description__content :is(h1, h2, h3, h4, h5, h6) {
    margin-block-start: 1.75em;
    font-size: 1.125rem;
    line-height: 1.3;
    color: var(--color-foreground);
  }

  .product-description__content :is(strong, b) {
    color: var(--color-foreground);
  }

  .product-description__content a {
    color: var(--color-foreground);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .product-description__content :is(ul, ol) {
    padding-inline-start: 1.25em;
  }

  .product-description__content li + li {
    margin-block-start: 0.4em;
  }

  .product-description__content li::marker {
    color: var(--color-foreground);
  }

  .product-description__content blockquote {
    padding-inline-start: 1em;
    border-inline-start: 2px solid var(--product-description-border);
    font-style: italic;
  }

  .product-description__content img {
    border-radius: 0.5rem;
  }

  .product-description__content table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  .product-description__content :is(th, td) {
    padding: 0.625rem 0.75rem;
    border-block-end: 1px solid var(--product-description-border);
    text-align: start;
  }

  .product-description__content iframe {
    max-width: 100%;
    aspect-ratio: 16 / 9;
    height: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .product-description__icon {
      transition: none;
    }
  }
{% endstylesheet %}

<div class="product-form">
  {% form 'product', product %}
    {% assign current_variant = product.selected_or_first_available_variant %}

    <select name="id">
      {% for variant in product.variants %}
        <option
          value="{{ variant.id }}"
          {% if variant == current_variant %}
            selected="selected"
          {% endif %}
        >
          {{ variant.title }} - {{ variant.price | money }}
        </option>
      {% endfor %}
    </select>

    <input type="text" name="quantity" min="1" value="1">

    <input type="submit" value="Add to cart">
    {{ form | payment_button }}
  {% endform %}
</div>

{% schema %}
{
  "name": "t:general.product",
  "settings": [],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
