{% comment %}
  This section is used in the product template to render product page with
  media, content, and add-to-cart form.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

{% assign current_variant = product.selected_or_first_available_variant %}

<product-info class="product">
  <div class="product__media">
    {% if product.images.size > 0 %}
      {% assign gallery_id = 'ProductGallery-' | append: section.id %}
      <product-tab-gallery class="product-gallery">
        <div class="product-gallery__panels">
          {% for image in product.images %}
            <div
              class="product-gallery__panel"
              id="{{ gallery_id }}-panel-{{ forloop.index }}"
              {% if forloop.length > 1 %}
                role="tabpanel"
                aria-labelledby="{{ gallery_id }}-tab-{{ forloop.index }}"
              {% endif %}
              {% unless forloop.first %}
                hidden
              {% endunless %}
            >
              {% liquid
                assign image_alt = image.alt | default: product.title
                if forloop.first
                  assign image_loading = 'eager'
                  assign image_priority = 'high'
                else
                  assign image_loading = 'lazy'
                  assign image_priority = 'auto'
                endif
              %}
              {{
                image
                | image_url: width: 1600
                | image_tag:
                  widths: '400, 600, 800, 1000, 1300, 1600',
                  sizes: '(min-width: 990px) calc(50vw - 4rem), calc(100vw - 2rem)',
                  loading: image_loading,
                  fetchpriority: image_priority,
                  alt: image_alt,
                  class: 'product-gallery__image'
              }}
            </div>
          {% endfor %}
        </div>

        {% if product.images.size > 1 %}
          <div
            class="product-gallery__tabs"
            role="tablist"
            aria-label="{{ 'products.gallery.label' | t }}"
          >
            {% for image in product.images %}
              <button
                type="button"
                class="product-gallery__tab"
                id="{{ gallery_id }}-tab-{{ forloop.index }}"
                role="tab"
                aria-controls="{{ gallery_id }}-panel-{{ forloop.index }}"
                aria-label="{{ 'products.gallery.show_image' | t: index: forloop.index, total: forloop.length }}"
                {% if forloop.first %}
                  aria-selected="true"
                  tabindex="0"
                {% else %}
                  aria-selected="false"
                  tabindex="-1"
                {% endif %}
              >
                {{
                  image
                  | image_url: width: 200, height: 200, crop: 'center'
                  | image_tag: loading: 'lazy', alt: '', class: 'product-gallery__thumb'
                }}
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </product-tab-gallery>
    {% endif %}
  </div>

  <div class="product__info">
    <h1 class="product__title">{{ product.title | escape }}</h1>

    <div
      class="product__price"
      data-product-price
      data-label-sale="{{ 'products.price.sale' | t | escape }}"
      data-label-regular="{{ 'products.price.regular' | t | escape }}"
    >
      {%- if current_variant.compare_at_price > current_variant.price -%}
        <span class="visually-hidden">{{ 'products.price.sale' | t }}</span>
        <span class="product__price-current">{{ current_variant.price | money }}</span>
        <span class="visually-hidden">{{ 'products.price.regular' | t }}</span>
        <s class="product__price-compare">{{ current_variant.compare_at_price | money }}</s>
      {%- else -%}
        <span class="product__price-current">{{ current_variant.price | money }}</span>
      {%- endif -%}
    </div>

    {% if product.description != blank %}
      <details class="product-description" open>
        <summary class="product-description__summary">
          <h2 class="product-description__title">{{ 'products.description' | t }}</h2>
          <svg
            class="product-description__icon"
            aria-hidden="true"
            focusable="false"
            viewBox="0 0 16 16"
            width="16"
            height="16"
          >
            <path d="M3 6l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </summary>
        <div class="product-description__content rte">
          {{ product.description }}
        </div>
      </details>
    {% endif %}

    <div class="product-form">
      {% form 'product', product, class: 'product-form__form' %}
        {{ form.errors | default_errors }}

        {% if product.has_only_default_variant %}
          <input type="hidden" name="id" value="{{ current_variant.id }}">
        {% else %}
          <div class="product-form__field">
            <label class="product-form__label" for="ProductVariant-{{ section.id }}">
              {{- 'products.form.variant' | t -}}
            </label>
            <select
              class="product-form__input"
              id="ProductVariant-{{ section.id }}"
              name="id"
              data-variant-select
            >
              {% for variant in product.variants %}
                <option
                  value="{{ variant.id }}"
                  data-price="{{ variant.price | money | escape }}"
                  data-compare-price="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | escape }}{% endif %}"
                  data-available="{{ variant.available }}"
                  {% if variant == current_variant %}
                    selected="selected"
                  {% endif %}
                >
                  {{ variant.title | escape }}
                  {%- unless variant.available %} - {{ 'products.form.sold_out' | t }}{% endunless %}
                </option>
              {% endfor %}
            </select>
          </div>
        {% endif %}

        <div class="product-form__field">
          <label class="product-form__label" for="ProductQuantity-{{ section.id }}">
            {{- 'products.form.quantity' | t -}}
          </label>
          <input
            class="product-form__input product-form__quantity"
            id="ProductQuantity-{{ section.id }}"
            type="number"
            name="quantity"
            min="1"
            step="1"
            value="1"
            inputmode="numeric"
          >
        </div>

        <div class="product-form__buttons">
          <button
            type="submit"
            class="product-form__submit"
            data-add-to-cart
            data-label-available="{{ 'products.form.add_to_cart' | t | escape }}"
            data-label-sold-out="{{ 'products.form.sold_out' | t | escape }}"
            {% unless current_variant.available %}
              disabled
            {% endunless %}
          >
            {%- if current_variant.available -%}
              {{ 'products.form.add_to_cart' | t }}
            {%- else -%}
              {{ 'products.form.sold_out' | t }}
            {%- endif -%}
          </button>
          {{ form | payment_button }}
        </div>
      {% endform %}
    </div>
  </div>
</product-info>

{% stylesheet %}
  .product {
    display: grid;
    gap: 2rem;
    padding-block: 2rem 4rem;
  }

  .product__media {
    min-width: 0;
  }

  .product__info {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    min-width: 0;
  }

  .product__title {
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.5rem);
    line-height: 1.15;
  }

  .product__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 1.25rem;
  }

  .product__price-current {
    font-weight: 600;
  }

  .product__price-compare {
    font-size: 1rem;
    opacity: 0.6;
  }

  .product-form__form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .product-form__field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .product-form__label {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .product-form__input {
    padding: 0.75rem 1rem;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 25%, transparent);
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .product-form__input:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }

  .product-form__quantity {
    max-width: 7rem;
  }

  .product-form__buttons {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .product-form__submit {
    width: 100%;
    padding: 0.875rem 1.75rem;
    border: 1px solid var(--color-foreground);
    border-radius: var(--style-border-radius-inputs);
    background-color: var(--color-foreground);
    color: var(--color-background);
    font: inherit;
    font-weight: 700;
    line-height: 1.2;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .product-form__submit:hover:not(:disabled) {
    opacity: 0.85;
  }

  .product-form__submit:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }

  .product-form__submit:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (min-width: 990px) {
    .product {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas: 'media info';
      align-items: start;
      gap: 4rem;
    }

    .product__info {
      grid-area: info;
    }

    .product__media {
      grid-area: media;
      position: sticky;
      top: 2rem;
    }
  }

  .product-gallery {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .product-gallery__panels {
    overflow: hidden;
    border-radius: 0.5rem;
    background-color: color-mix(in srgb, var(--color-foreground) 4%, transparent);
  }

  .product-gallery__panel {
    view-transition-name: product-gallery-image;
  }

  .product-gallery__image {
    width: 100%;
    aspect-ratio: 1;
    object-fit: contain;
  }

  .product-gallery__tabs {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    padding: 2px;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
  }

  .product-gallery__tab {
    flex: 0 0 4.5rem;
    padding: 0;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 15%, transparent);
    border-radius: 0.375rem;
    background: none;
    cursor: pointer;
    opacity: 0.6;
    scroll-snap-align: start;
    transition: opacity 0.2s ease, border-color 0.2s ease;
  }

  .product-gallery__tab:hover {
    opacity: 1;
  }

  .product-gallery__tab[aria-selected='true'] {
    border-color: var(--color-foreground);
    opacity: 1;
  }

  .product-gallery__tab:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }

  .product-gallery__thumb {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  @media (min-width: 750px) {
    .product-gallery__tab {
      flex-basis: 5.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-gallery__tab,
    .product-form__submit {
      transition: none;
    }

    ::view-transition-group(product-gallery-image) {
      animation: none;
    }
  }

  .product-description {
    --product-description-border: color-mix(in srgb, var(--color-foreground) 15%, transparent);
    --product-description-muted: color-mix(in srgb, var(--color-foreground) 75%, transparent);

    margin-block-start: 2rem;
    border-block: 1px solid var(--product-description-border);
  }

  .product-description__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.25rem;
    cursor: pointer;
    list-style: none;
  }

  .product-description__summary::-webkit-details-marker {
    display: none;
  }

  .product-description__summary:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: 4px;
  }

  .product-description__title {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .product-description__icon {
    flex-shrink: 0;
    transition: transform 0.25s ease;
  }

  .product-description[open] .product-description__icon {
    transform: rotate(180deg);
  }

  .product-description__content {
    max-width: 65ch;
    padding-block-end: 1.5rem;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--product-description-muted);
  }

  .product-description__content > * + * {
    margin-block-start: 1em;
  }

  .product-description__content :is(h1, h2, h3, h4, h5, h6) {
    margin-block-start: 1.75em;
    font-size: 1.125rem;
    line-height: 1.3;
    color: var(--color-foreground);
  }

  .product-description__content :is(strong, b) {
    color: var(--color-foreground);
  }

  .product-description__content a {
    color: var(--color-foreground);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .product-description__content :is(ul, ol) {
    padding-inline-start: 1.25em;
  }

  .product-description__content li + li {
    margin-block-start: 0.4em;
  }

  .product-description__content li::marker {
    color: var(--color-foreground);
  }

  .product-description__content blockquote {
    padding-inline-start: 1em;
    border-inline-start: 2px solid var(--product-description-border);
    font-style: italic;
  }

  .product-description__content img {
    border-radius: 0.5rem;
  }

  .product-description__content table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  .product-description__content :is(th, td) {
    padding: 0.625rem 0.75rem;
    border-block-end: 1px solid var(--product-description-border);
    text-align: start;
  }

  .product-description__content iframe {
    max-width: 100%;
    aspect-ratio: 16 / 9;
    height: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .product-description__icon {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  class ProductTabGallery extends HTMLElement {
    connectedCallback() {
      this.tabs = Array.from(this.querySelectorAll('[role="tab"]'));
      this.tabs.forEach((tab) => {
        tab.addEventListener('click', () => this.select(tab));
        tab.addEventListener('keydown', (event) => this.onKeydown(event));
      });
    }

    onKeydown(event) {
      const index = this.tabs.indexOf(event.currentTarget);
      const last = this.tabs.length - 1;
      const targets = {
        ArrowRight: index === last ? 0 : index + 1,
        ArrowLeft: index === 0 ? last : index - 1,
        Home: 0,
        End: last,
      };
      if (!(event.key in targets)) return;
      event.preventDefault();
      const tab = this.tabs[targets[event.key]];
      tab.focus();
      this.select(tab);
    }

    select(tab) {
      if (tab.getAttribute('aria-selected') === 'true') return;
      const update = () => {
        this.tabs.forEach((item) => {
          const selected = item === tab;
          item.setAttribute('aria-selected', String(selected));
          item.tabIndex = selected ? 0 : -1;
          document.getElementById(item.getAttribute('aria-controls')).hidden = !selected;
        });
      };
      if (document.startViewTransition) {
        document.startViewTransition(update);
      } else {
        update();
      }
      tab.scrollIntoView({ block: 'nearest', inline: 'nearest' });
    }
  }

  if (!customElements.get('product-tab-gallery')) {
    customElements.define('product-tab-gallery', ProductTabGallery);
  }

  class ProductInfo extends HTMLElement {
    connectedCallback() {
      this.select = this.querySelector('[data-variant-select]');
      if (!this.select) return;
      this.price = this.querySelector('[data-product-price]');
      this.submit = this.querySelector('[data-add-to-cart]');
      this.select.addEventListener('change', () => this.onVariantChange());
    }

    onVariantChange() {
      const option = this.select.selectedOptions[0];
      const { price, comparePrice, available } = option.dataset;
      const { labelSale, labelRegular } = this.price.dataset;
      const create = (tag, className, text) => {
        const element = document.createElement(tag);
        element.className = className;
        element.textContent = text;
        return element;
      };
      const current = create('span', 'product__price-current', price);
      if (comparePrice) {
        this.price.replaceChildren(
          create('span', 'visually-hidden', labelSale),
          current,
          create('span', 'visually-hidden', labelRegular),
          create('s', 'product__price-compare', comparePrice)
        );
      } else {
        this.price.replaceChildren(current);
      }
      const isAvailable = available === 'true';
      this.submit.disabled = !isAvailable;
      this.submit.textContent = isAvailable
        ? this.submit.dataset.labelAvailable
        : this.submit.dataset.labelSoldOut;
      const url = new URL(window.location.href);
      url.searchParams.set('variant', option.value);
      window.history.replaceState({}, '', url);
    }
  }

  if (!customElements.get('product-info')) {
    customElements.define('product-info', ProductInfo);
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:general.product",
  "settings": [],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
