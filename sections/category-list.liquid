<div class="category-list">
  {% if section.settings.heading != blank %}
    <h2 class="category-list__heading">{{ section.settings.heading | escape }}</h2>
  {% endif %}

  <ul class="category-list__grid" role="list">
    {% for block in section.blocks %}
      {% liquid
        assign category = block.settings.collection
        assign title = block.settings.title | default: category.title
        assign image = block.settings.image | default: category.featured_image
        assign url = category.url | default: routes.collections_url
      %}

      <li {{ block.shopify_attributes }}>
        <a class="category-card" href="{{ url }}">
          {% if image %}
            {% render 'image', class: 'category-card__image', image: image, width: 600, height: 600, crop: 'center' %}
          {% else %}
            {% capture placeholder %}{% cycle 'collection-apparel-1', 'collection-apparel-2', 'collection-apparel-3', 'collection-apparel-4' %}{% endcapture %}
            <div class="category-card__image">
              {{ placeholder | placeholder_svg_tag }}
            </div>
          {% endif %}

          <p class="category-card__title">{{ title | escape }}</p>
        </a>
      </li>
    {% endfor %}
  </ul>
</div>

{% stylesheet %}
  .category-list {
    padding-block: 4rem 2rem;
  }

  .category-list__heading {
    margin-bottom: 2rem;
    font-size: 2rem;
    font-weight: 700;
    text-align: center;
  }

  .category-list__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .category-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    color: var(--color-foreground);
    text-align: center;
    text-decoration: none;
  }

  .category-card__image {
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--style-border-radius-inputs);
    background-color: rgb(from var(--color-foreground) r g b / 0.05);
  }

  .category-card__image > img,
  .category-card__image > svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .category-card:hover .category-card__image > * {
    transform: scale(1.04);
  }

  .category-card__title {
    font-weight: 700;
  }

  @media (max-width: 749px) {
    .category-list__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .category-card__image > * {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.category_list",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Categories"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "t:general.category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:general.collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.title"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.category_list",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
