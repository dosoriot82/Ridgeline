<header class="header" style="--header-logo-width: {{ section.settings.logo_width }}px">
  <a class="header__logo" href="{{ routes.root_url }}">
    {% if section.settings.logo %}
      {{
        section.settings.logo
        | image_url: width: 600
        | image_tag: alt: shop.name, widths: '150, 300, 450, 600', sizes: '(min-width: 750px) 300px, 150px', loading: 'eager'
      }}
    {% else %}
      <span class="header__title">{{ shop.name }}</span>
    {% endif %}
  </a>

  {% if section.settings.menu.links.size > 0 %}
    <details class="header__toggle">
      <summary aria-label="{{ 'sections.header.open_menu' | t }}">
        <span></span>
        <span></span>
        <span></span>
      </summary>
    </details>

    <nav class="header__menu" aria-label="{{ 'sections.header.main_navigation' | t }}">
      {% for link in section.settings.menu.links %}
        <a
          href="{{ link.url }}"
          {% if link.current %}
            aria-current="page"
          {% endif %}
        >
          {{- link.title | escape -}}
        </a>
      {% endfor %}
    </nav>
  {% endif %}

  <div class="header__icons">
    {% if shop.customer_accounts_enabled %}
      <shopify-account menu="{{ section.settings.customer_account_menu }}">
        {{ 'icon-account.svg' | inline_asset_content }}
      </shopify-account>
    {% endif %}

    <a
      class="header__cart"
      href="{{ routes.cart_url }}"
      aria-label="{{ 'sections.header.cart_count' | t: count: cart.item_count }}"
    >
      {{ 'icon-cart.svg' | inline_asset_content }}

      {% if cart.item_count > 0 %}
        <span class="header__cart-count" aria-hidden="true">
          {%- if cart.item_count < 100 -%}
            {{ cart.item_count }}
          {%- else -%}
            99+
          {%- endif -%}
        </span>
      {% endif %}
    </a>
  </div>
</header>

{% stylesheet %}
  .shopify-section:has(> .header) {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--color-background);
    border-bottom: 3px solid #ee6b19;
  }
  .header {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: 'logo menu icons';
    align-items: center;
    gap: 1.5rem;
    min-height: 5rem;
    padding-block: 0.75rem;
  }
  .header a {
    position: relative;
    text-decoration: none;
    color: var(--color-foreground);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .header svg {
    width: 2rem;
  }
  .header__logo {
    grid-area: logo;
  }
  .header__logo img {
    width: var(--header-logo-width);
    height: auto;
  }
  .header__title {
    font-size: 1.5rem;
    font-weight: 700;
  }
  .header__menu {
    grid-area: menu;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 2rem;
  }
  .header__menu a {
    padding-block: 0.25rem;
    border-bottom: 2px solid transparent;
  }
  .header__menu a:hover,
  .header__menu a[aria-current] {
    border-bottom-color: currentcolor;
  }
  .header__icons {
    grid-area: icons;
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .header__cart-count {
    position: absolute;
    top: -0.25rem;
    left: 60%;
    min-width: 1.25rem;
    padding: 0 0.3rem;
    border-radius: 999px;
    background-color: var(--color-foreground);
    color: var(--color-background);
    font-size: 0.75rem;
    line-height: 1.25rem;
    text-align: center;
  }
  .header__toggle {
    display: none;
  }

  @media (max-width: 749px) {
    .header {
      grid-template-areas:
        'toggle logo icons'
        'menu menu menu';
      column-gap: 1rem;
      row-gap: 0;
    }
    .header__logo {
      justify-self: start;
    }
    .header__toggle {
      display: block;
      grid-area: toggle;
    }
    .header__toggle summary {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 2.75rem;
      height: 2.75rem;
      cursor: pointer;
      list-style: none;
    }
    .header__toggle summary::-webkit-details-marker {
      display: none;
    }
    .header__toggle span {
      width: 1.5rem;
      height: 2px;
      background-color: var(--color-foreground);
    }
    .header__menu {
      display: none;
    }
    .header__toggle[open] ~ .header__menu {
      display: flex;
      flex-direction: column;
      gap: 0;
      padding-block: 0.5rem;
    }
    .header .header__menu a {
      justify-content: flex-start;
      padding-block: 0.75rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:labels.logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "t:labels.logo_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 140
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
