{% doc %}
  @prompt
    Agrega una sección para conectar 1 producto y se pueda visualizar todos su información (fotos, descripción, precios y más)
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-featured-product-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    color: #333333;
    font-family: inherit;
  }
  .ai-featured-product-{{ ai_gen_id }}__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.9fr);
    gap: 36px;
    align-items: start;
  }
  .ai-featured-product-{{ ai_gen_id }}__gallery { min-width: 0; }
  .ai-featured-product-{{ ai_gen_id }}__main-image,
  .ai-featured-product-{{ ai_gen_id }}__placeholder {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    background: #f2f2f2;
    border-radius: 4px;
  }
  .ai-featured-product-{{ ai_gen_id }}__placeholder { overflow: hidden; }
  .ai-featured-product-{{ ai_gen_id }}__placeholder svg { display: block; width: 100%; height: 100%; }
  .ai-featured-product-{{ ai_gen_id }}__thumbs {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 8px;
    margin-top: 10px;
  }
  .ai-featured-product-{{ ai_gen_id }}__thumb {
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid #b8b8b8;
    border-radius: 3px;
    background: #f2f2f2;
    cursor: pointer;
    overflow: hidden;
  }
  .ai-featured-product-{{ ai_gen_id }}__thumb[aria-current="true"] { border: 2px solid #333333; }
  .ai-featured-product-{{ ai_gen_id }}__thumb img { display: block; width: 100%; aspect-ratio: 1 / 1; object-fit: cover; }
  .ai-featured-product-{{ ai_gen_id }}__info { min-width: 0; }
  .ai-featured-product-{{ ai_gen_id }}__vendor { margin: 0 0 8px; font-size: 0.85em; letter-spacing: 0.06em; text-transform: uppercase; }
  .ai-featured-product-{{ ai_gen_id }}__title { margin: 0 0 12px; font-size: clamp(1.6rem, 3vw, 2.4rem); line-height: 1.15; }
  .ai-featured-product-{{ ai_gen_id }}__price { display: flex; align-items: baseline; gap: 10px; margin: 0 0 16px; font-size: 1.25rem; }
  .ai-featured-product-{{ ai_gen_id }}__compare { color: #595959; text-decoration: line-through; font-size: 0.9em; }
  .ai-featured-product-{{ ai_gen_id }}__description { margin: 0 0 20px; line-height: 1.6; }
  .ai-featured-product-{{ ai_gen_id }}__description p:first-child { margin-top: 0; }
  .ai-featured-product-{{ ai_gen_id }}__description p:last-child { margin-bottom: 0; }
  .ai-featured-product-{{ ai_gen_id }}__options { margin: 0 0 16px; }
  .ai-featured-product-{{ ai_gen_id }}__label { display: block; margin-bottom: 7px; font-weight: 600; }
  .ai-featured-product-{{ ai_gen_id }}__select,
  .ai-featured-product-{{ ai_gen_id }}__quantity {
    width: 100%;
    min-height: 46px;
    padding: 10px 12px;
    border: 1px solid #767676;
    border-radius: 4px;
    background: #ffffff;
    color: #222222;
    font: inherit;
  }
  .ai-featured-product-{{ ai_gen_id }}__quantity { max-width: 120px; }
  .ai-featured-product-{{ ai_gen_id }}__button {
    display: block;
    width: 100%;
    min-height: 48px;
    margin-top: 18px;
    padding: 12px 18px;
    border: 1px solid #333333;
    border-radius: 4px;
    background: #333333;
    color: #ffffff;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .ai-featured-product-{{ ai_gen_id }}__button:hover { background: #1f1f1f; }
  .ai-featured-product-{{ ai_gen_id }}__button:focus-visible,
  .ai-featured-product-{{ ai_gen_id }}__thumb:focus-visible,
  .ai-featured-product-{{ ai_gen_id }}__select:focus-visible,
  .ai-featured-product-{{ ai_gen_id }}__quantity:focus-visible { outline: 3px solid #1b5eaa; outline-offset: 2px; }
  .ai-featured-product-{{ ai_gen_id }}__button:disabled { opacity: 0.65; cursor: not-allowed; }
  .ai-featured-product-{{ ai_gen_id }}__empty {
    display: flex;
    min-height: 300px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: #f2f2f2;
    color: #444444;
    text-align: center;
  }
  .ai-featured-product-{{ ai_gen_id }}__empty p { margin: 12px 0 0; }
  @media screen and (max-width: 749px) {
    .ai-featured-product-{{ ai_gen_id }}__layout { grid-template-columns: 1fr; gap: 24px; }
  }
{% endstyle %}

<featured-product-{{ ai_gen_id }} class="ai-featured-product-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% assign featured_product = block.settings.product %}
  {% if featured_product != blank %}
    {% assign current_variant = featured_product.selected_or_first_available_variant %}
    <div class="ai-featured-product-{{ ai_gen_id }}__layout">
      <div class="ai-featured-product-{{ ai_gen_id }}__gallery">
        {% if featured_product.featured_image %}
          <img class="ai-featured-product-{{ ai_gen_id }}__main-image" data-main-image src="{{ featured_product.featured_image | image_url: width: 1200 }}" alt="{{ featured_product.featured_image.alt | default: featured_product.title | escape }}" width="{{ featured_product.featured_image.width }}" height="{{ featured_product.featured_image.height }}" loading="lazy">
          {% if featured_product.images.size > 1 %}
            <div class="ai-featured-product-{{ ai_gen_id }}__thumbs" aria-label="Fotos del producto">
              {% for image in featured_product.images limit: 5 %}
                <button class="ai-featured-product-{{ ai_gen_id }}__thumb" type="button" data-image-src="{{ image | image_url: width: 1200 }}" data-image-alt="{{ image.alt | default: featured_product.title | escape }}" aria-label="Ver foto {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">
                  <img src="{{ image | image_url: width: 180 }}" alt="" width="180" height="180" loading="lazy">
                </button>
              {% endfor %}
            </div>
          {% endif %}
        {% else %}
          <div class="ai-featured-product-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
        {% endif %}
      </div>
      <div class="ai-featured-product-{{ ai_gen_id }}__info">
        {% if block.settings.show_vendor and featured_product.vendor != blank %}<p class="ai-featured-product-{{ ai_gen_id }}__vendor">{{ featured_product.vendor | escape }}</p>{% endif %}
        <h2 class="ai-featured-product-{{ ai_gen_id }}__title">{{ featured_product.title | escape }}</h2>
        <p class="ai-featured-product-{{ ai_gen_id }}__price" data-price>
          <span>{{ current_variant.price | money }}</span>
          <s class="ai-featured-product-{{ ai_gen_id }}__compare" data-compare {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>{{ current_variant.compare_at_price | money }}</s>
        </p>
        {% if block.settings.show_description and featured_product.description != blank %}
          <div class="ai-featured-product-{{ ai_gen_id }}__description">{{ featured_product.description }}</div>
        {% endif %}
        {% form 'product', featured_product %}
          {% unless featured_product.has_only_default_variant %}
            <div class="ai-featured-product-{{ ai_gen_id }}__options">
              <label class="ai-featured-product-{{ ai_gen_id }}__label" for="variant-{{ ai_gen_id }}">Variante</label>
              <select id="variant-{{ ai_gen_id }}" class="ai-featured-product-{{ ai_gen_id }}__select" name="id" data-variant-select>
                {% for variant in featured_product.variants %}
                  <option value="{{ variant.id }}" data-price="{{ variant.price }}" data-compare="{{ variant.compare_at_price | default: 0 }}" data-available="{{ variant.available }}" {% if variant.id == current_variant.id %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>
                    {{ variant.title | escape }}{% unless variant.available %} — Agotado{% endunless %}
                  </option>
                {% endfor %}
              </select>
            </div>
          {% else %}
            <input type="hidden" name="id" value="{{ current_variant.id }}">
          {% endunless %}
          {% if block.settings.show_quantity %}
            <div class="ai-featured-product-{{ ai_gen_id }}__options">
              <label class="ai-featured-product-{{ ai_gen_id }}__label" for="quantity-{{ ai_gen_id }}">Cantidad</label>
              <input class="ai-featured-product-{{ ai_gen_id }}__quantity" id="quantity-{{ ai_gen_id }}" type="number" name="quantity" value="1" min="1">
            </div>
          {% endif %}
          <button class="ai-featured-product-{{ ai_gen_id }}__button" type="submit" data-add-button {% unless current_variant.available %}disabled{% endunless %}>{% if current_variant.available %}Agregar al carrito{% else %}Agotado{% endif %}</button>
        {% endform %}
      </div>
    </div>
  {% else %}
    <div class="ai-featured-product-{{ ai_gen_id }}__empty">
      {{ 'product-apparel-1' | placeholder_svg_tag }}
      <p>Selecciona un producto en la configuración del bloque para mostrar sus fotos, descripción, precio y variantes.</p>
    </div>
  {% endif %}
</featured-product-{{ ai_gen_id }}>

<script>
  (function() {
    var elementName = 'featured-product-{{ ai_gen_id }}';
    if (customElements.get(elementName)) return;
    class FeaturedProduct{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        var mainImage = this.querySelector('[data-main-image]');
        this.querySelectorAll('[data-image-src]').forEach(function(button) {
          button.addEventListener('click', function() {
            if (!mainImage) return;
            mainImage.src = button.dataset.imageSrc;
            mainImage.alt = button.dataset.imageAlt;
            this.querySelectorAll('[data-image-src]').forEach(function(item) { item.setAttribute('aria-current', 'false'); });
            button.setAttribute('aria-current', 'true');
          }.bind(this));
        }, this);
        var selector = this.querySelector('[data-variant-select]');
        if (selector) {
          selector.addEventListener('change', function() {
            var option = selector.options[selector.selectedIndex];
            var price = this.querySelector('[data-price] span');
            var compare = this.querySelector('[data-compare]');
            var button = this.querySelector('[data-add-button]');
            if (price) price.textContent = this.formatMoney(option.dataset.price);
            if (compare) {
              var compareValue = Number(option.dataset.compare || 0);
              var priceValue = Number(option.dataset.price || 0);
              compare.hidden = compareValue <= priceValue;
              if (!compare.hidden) compare.textContent = this.formatMoney(compareValue);
            }
            if (button) {
              button.disabled = option.dataset.available !== 'true';
              button.textContent = button.disabled ? 'Agotado' : 'Agregar al carrito';
            }
          }.bind(this));
        }
      }
      formatMoney(cents) {
        return new Intl.NumberFormat('{{ shop.locale }}', { style: 'currency', currency: '{{ cart.currency.iso_code | default: shop.currency }}' }).format(Number(cents) / 100);
      }
    }
    customElements.define(elementName, FeaturedProduct{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Producto destacado",
  "settings": [
    { "type": "product", "id": "product", "label": "Producto" },
    { "type": "range", "id": "desktop_width_percent", "label": "Ancho en escritorio", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "header", "content": "Información visible" },
    { "type": "checkbox", "id": "show_vendor", "label": "Mostrar proveedor", "default": true },
    { "type": "checkbox", "id": "show_description", "label": "Mostrar descripción", "default": true },
    { "type": "checkbox", "id": "show_quantity", "label": "Mostrar selector de cantidad", "default": true }
  ],
  "presets": [
    { "name": "Producto destacado" }
  ],
  "tag": null,
  "class": "featured-product-block"
}
{% endschema %}