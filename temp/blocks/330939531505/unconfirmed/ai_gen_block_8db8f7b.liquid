{% doc %}
  @prompt
    Crea una sección para conectar los productos
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-connect-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: 28px;
    color: #333333;
    background: #ffffff;
    border: 1px solid #dedede;
    border-radius: 8px;
    box-sizing: border-box;
    font-family: inherit;
  }

  .ai-product-connect-{{ ai_gen_id }}__heading {
    margin: 0 0 18px;
    color: #222222;
    font-size: 22px;
    line-height: 1.3;
  }

  .ai-product-connect-{{ ai_gen_id }}__list {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr));
    gap: 14px;
  }

  .ai-product-connect-{{ ai_gen_id }}__card {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
    padding: 12px;
    color: #333333;
    text-decoration: none;
    border: 1px solid #dedede;
    border-radius: 6px;
    transition: border-color 0.2s ease;
  }

  .ai-product-connect-{{ ai_gen_id }}__card:hover {
    border-color: #555555;
  }

  .ai-product-connect-{{ ai_gen_id }}__card:focus-visible {
    outline: 2px solid #333333;
    outline-offset: 3px;
  }

  .ai-product-connect-{{ ai_gen_id }}__image-wrap {
    flex: 0 0 72px;
    width: 72px;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 4px;
    background: #f2f2f2;
  }

  .ai-product-connect-{{ ai_gen_id }}__image-wrap img,
  .ai-product-connect-{{ ai_gen_id }}__image-wrap svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-connect-{{ ai_gen_id }}__details {
    min-width: 0;
  }

  .ai-product-connect-{{ ai_gen_id }}__title {
    margin: 0 0 5px;
    color: #222222;
    font-size: 15px;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .ai-product-connect-{{ ai_gen_id }}__price {
    margin: 0;
    color: #333333;
    font-size: 14px;
  }

  .ai-product-connect-{{ ai_gen_id }}__empty {
    margin: 0;
    color: #595959;
    font-size: 14px;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-product-connect-{{ ai_gen_id }} {
      width: 100%;
      padding: 20px;
    }

    .ai-product-connect-{{ ai_gen_id }}__list {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

<div class="ai-product-connect-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-product-connect-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
  {% endif %}

  {% if block.settings.products != blank %}
    <div class="ai-product-connect-{{ ai_gen_id }}__list">
      {% for connected_product in block.settings.products %}
        <a class="ai-product-connect-{{ ai_gen_id }}__card" href="{{ connected_product.url }}" aria-label="{{ connected_product.title | escape }} — {{ connected_product.price | money }}">
          <div class="ai-product-connect-{{ ai_gen_id }}__image-wrap">
            {% if connected_product.featured_image %}
              <img src="{{ connected_product.featured_image | image_url: width: 180 }}" alt="{{ connected_product.featured_image.alt | default: connected_product.title | escape }}" width="180" height="180" loading="lazy">
            {% else %}
              {{ 'product-apparel-1' | placeholder_svg_tag }}
            {% endif %}
          </div>
          <div class="ai-product-connect-{{ ai_gen_id }}__details">
            <h3 class="ai-product-connect-{{ ai_gen_id }}__title">{{ connected_product.title | escape }}</h3>
            <p class="ai-product-connect-{{ ai_gen_id }}__price">{{ connected_product.price | money }}</p>
          </div>
        </a>
      {% endfor %}
    </div>
  {% else %}
    <p class="ai-product-connect-{{ ai_gen_id }}__empty">Selecciona productos relacionados en los ajustes del bloque para mostrarlos aquí.</p>
  {% endif %}
</div>

{% schema %}
{
  "name": "Productos conectados",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Encabezado",
      "default": "Completa tu equipo"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Productos relacionados",
      "limit": 6
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columnas en escritorio",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Ancho en escritorio",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Productos conectados"
    }
  ],
  "tag": null,
  "class": "connected-products-block"
}
{% endschema %}