{% doc %}
  @prompt
    Agrega una sección para agregar los productos relacionados
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-related-products-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: #333333;
    font-family: inherit;
  }

  .ai-related-products-{{ ai_gen_id }}__heading {
    margin: 0 0 20px;
    color: #333333;
    font-size: clamp(1.35rem, 2vw, 1.8rem);
    line-height: 1.2;
  }

  .ai-related-products-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr));
    gap: 20px;
  }

  .ai-related-products-{{ ai_gen_id }}__card {
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  .ai-related-products-{{ ai_gen_id }}__media {
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #f3f3f3;
    border-radius: {{ block.settings.corner_radius }}px;
  }

  .ai-related-products-{{ ai_gen_id }}__media img,
  .ai-related-products-{{ ai_gen_id }}__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-related-products-{{ ai_gen_id }}__details {
    padding-top: 12px;
  }

  .ai-related-products-{{ ai_gen_id }}__title {
    margin: 0 0 6px;
    color: #333333;
    font-size: 1rem;
    line-height: 1.4;
  }

  .ai-related-products-{{ ai_gen_id }}__price {
    margin: 0;
    color: #333333;
    font-size: 0.95rem;
  }

  .ai-related-products-{{ ai_gen_id }}__empty {
    padding: 28px 20px;
    background: #f3f3f3;
    border-radius: {{ block.settings.corner_radius }}px;
    color: #333333;
    text-align: center;
  }

  .ai-related-products-{{ ai_gen_id }}__empty p {
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-related-products-{{ ai_gen_id }}__grid {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, minmax(0, 1fr));
      gap: 12px;
    }
  }
{% endstyle %}

<div class="ai-related-products-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-related-products-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
  {% endif %}

  {% if block.settings.related_products != blank %}
    <div class="ai-related-products-{{ ai_gen_id }}__grid">
      {% for related_product in block.settings.related_products limit: block.settings.product_limit %}
        <a class="ai-related-products-{{ ai_gen_id }}__card" href="{{ related_product.url }}">
          <div class="ai-related-products-{{ ai_gen_id }}__media">
            {% if related_product.featured_image %}
              <img
                src="{{ related_product.featured_image | image_url: width: 800 }}"
                alt="{{ related_product.featured_image.alt | default: related_product.title | escape }}"
                loading="lazy"
                width="{{ related_product.featured_image.width }}"
                height="{{ related_product.featured_image.height }}"
              >
            {% else %}
              {{ 'product-apparel-1' | placeholder_svg_tag }}
            {% endif %}
          </div>
          <div class="ai-related-products-{{ ai_gen_id }}__details">
            <h3 class="ai-related-products-{{ ai_gen_id }}__title">{{ related_product.title | escape }}</h3>
            <p class="ai-related-products-{{ ai_gen_id }}__price">{{ related_product.price | money }}</p>
          </div>
        </a>
      {% endfor %}
    </div>
  {% else %}
    <div class="ai-related-products-{{ ai_gen_id }}__empty">
      <p>Selecciona productos relacionados en la configuración de este bloque.</p>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Productos relacionados",
  "settings": [
    {
      "type": "header",
      "content": "Contenido"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "También te puede interesar"
    },
    {
      "type": "product_list",
      "id": "related_products",
      "label": "Productos relacionados",
      "limit": 12
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Número de productos",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Ancho en escritorio",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columnas en escritorio",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columnas en móvil",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Radio de esquinas",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Productos relacionados"
    }
  ],
  "tag": null,
  "class": "related-products-block"
}
{% endschema %}